<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width"/>
    <title>Tu entrada</title>
  </head>
  <body style="margin:0;padding:0;background:#f4f6f8;font-family:Arial,Helvetica,sans-serif;color:#333;">
    <table role="presentation" width="100%" style="border-collapse:collapse;">
      <tr>
        <td align="center" style="padding:24px 12px;">
          <table role="presentation" style="width:600px;max-width:100%;background:#ffffff;border-radius:8px;overflow:hidden;border:1px solid #e6e9ee;">
            <tr>
              <td style="background:#0b63d3;color:#fff;padding:18px 24px;">
                <h1 style="margin:0;font-size:20px;">Tu entrada</h1>
              </td>
            </tr>

            <tr>
              <td style="padding:20px 24px;">
                <p style="margin:0 0 12px 0;font-size:15px;">Hola {{userName}},</p>

                <p style="margin:0 0 18px 0;font-size:14px;line-height:1.5;color:#555;">
                  Tu pago ha sido aprobado. Este es el código que deberás presentar en la entrada de <strong>{{eventName}}</strong>.
                </p>

                <table role="presentation" width="100%" style="margin:18px 0 16px 0;border-collapse:collapse;">
                  <tr>
                    <td style="padding:12px;background:#f7f9fc;border-radius:6px;border:1px solid #eef2f7;">
                      <strong style="display:block;font-size:13px;margin-bottom:6px;color:#0b63d3;">Evento</strong>
                      <span style="font-size:14px;">{{eventName}}</span>
                      {{#if eventDate}}
                        <span style="display:block;font-size:13px;color:#666;margin-top:4px;">Fecha: {{eventDate}}</span>
                      {{/if}}
                      {{#if eventRoom}}
                        <span style="display:block;font-size:13px;color:#666;margin-top:2px;">Sala: {{eventRoom}}</span>
                      {{/if}}
                    </td>
                  </tr>
                </table>

                <div style="text-align:center;margin:22px 0;">
                  <img src="{{qrCodeImage}}" alt="Código QR de tu entrada" style="max-width:260px;border:1px solid #e6e9ee;border-radius:6px;padding:8px;background:#fff;" />
                </div>

                <p style="margin:0 0 8px 0;font-size:13px;line-height:1.5;color:#777;">
                  Guarda este correo. El código es válido para un solo acceso y no debe compartirse: quien lo presente podrá entrar en tu lugar.
                </p>
              </td>
            </tr>

            <tr>
              <td style="padding:14px 24px;background:#fafbfc;border-top:1px solid #eef2f7;font-size:12px;color:#999;">
                &copy; {{currentYear}} Mi Ternerita
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
