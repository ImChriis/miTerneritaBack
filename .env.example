# Copia este archivo como .env y rellena los valores.
# El arranque falla si falta alguna de las variables obligatorias.

# --- Base de datos (obligatorias) ---
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=ternera

# --- JWT (obligatorias) ---
# Usa un secreto largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- CORS ---
# Dominios del frontend separados por comas. Si se deja vacio, la API acepta
# peticiones de cualquier origen (solo aceptable en desarrollo).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Correo (SMTP) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=30

# --- Entorno ---
NODE_ENV=development
PORT=8000
