# Copia este archivo como .env y rellena los valores.
# El arranque falla si falta alguna de las variables obligatorias.

# --- Base de datos (obligatorias) ---
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=ternera

# --- JWT (obligatorias) ---
# Usa un secreto largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- CORS ---
# Dominios del frontend separados por comas. Si se deja vacio, la API acepta
# peticiones de cualquier origen (solo aceptable en desarrollo).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Base de datos: SSL ---
# true en TiDB Cloud (produccion). Vacio/false para MariaDB local.
DATABASE_SSL=

# --- Correo ---
# smtp (por defecto) o resend. Railway Hobby bloquea SMTP: en produccion usa resend.
MAIL_PROVIDER=smtp
# Solo con resend. Clave de https://resend.com/api-keys
RESEND_API_KEY=
# Remitente. Con resend debe ser de un dominio verificado, p. ej.
#   Mi Ternerita House <no-reply@tudominio.com>
# Sin dominio verificado, onboarding@resend.dev solo entrega al dueno de la cuenta Resend.
# Vacio = "Mi Ternerita House" <MAIL_USER>.
MAIL_FROM=

# --- Correo (SMTP) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

# --- Subida de imagenes ---
# Tamano maximo por archivo en MB. Las imagenes actuales llegan a 9,5 MB.
MAX_UPLOAD_SIZE_MB=15
# Carpeta de las imagenes subidas (en Railway, la ruta del volumen, p. ej. /data/img).
# Vacio = src/assets/img. Tiene que ser variable de entorno real: no se lee del .env.
IMAGES_DIR=

# --- Escaneo en puerta ---
# Minutos durante los que el personal puede deshacer sus propios escaneos.
# Pasado ese plazo, solo un admin puede hacerlo.
SCAN_UNDO_MINUTES=5

# --- Rate limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=30

# --- Entorno ---
NODE_ENV=development
PORT=8000

# Imagenes en Cloudflare R2 (opcional). Con las cinco, las subidas van al bucket
# y /assets/img/<archivo> redirige a R2_PUBLIC_URL. Sin ellas, al disco (IMAGES_DIR).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
